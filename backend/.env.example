# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb://127.0.0.1:27017/mini-social-app OR mongodb+srv://<user>:<password>@cluster0.mongodb.net/mini-social-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mini-social-app

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_change_in_production_3w_social_app

# JWT Expiration
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5178

# Cloudinary Configuration (Optional for cloud storage; falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
